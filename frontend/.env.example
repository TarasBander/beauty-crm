# Base URL prefixed to every API request (shared/api/http.ts). Leave
# unset for local dev and for any production deploy that serves the
# frontend and backend behind the same origin (a reverse proxy routing
# /api/* to the backend, same idea as vite.config.ts's dev-only proxy).
# Set it only when the built app must call a backend on a different
# origin, e.g.:
# VITE_API_BASE=https://api.example.com/api
